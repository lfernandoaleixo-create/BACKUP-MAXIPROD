  "query": "SELECT so.codigoItem, MAX(so.descricaoItem) as descricaoItem, DATE_FORMAT(SUBSTRING(so.dataEmissao, 1, 10), '%Y-%m') as yearMonth, SUM(so.quantidade) as totalQty, pv.parentCode, pv.conversionFactor FROM sales_orders so INNER JOIN product_variants pv ON so.codigoItem = pv.childCode WHERE so.estadoItem IN ('Faturado', 'Faturado parcial', 'Faturado c/ entrega futura') AND SUBSTRING(so.dataEmissao, 1, 10) >= '2025-02-01' GROUP BY so.codigoItem, yearMonth, pv.parentCode, pv.conversionFactor ORDER BY yearMonth DESC, totalQty DESC LIMIT 20;",
