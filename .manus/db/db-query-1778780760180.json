  "query": "\nSELECT ar.id, ar.cliente, ar.valorOriginal, ar.valorLiquido, ar.valorRecebidoLiquido,\n  (ar.valorLiquido - COALESCE(ar.valorRecebidoLiquido, 0)) as valorAReceber,\n  ar.vencimentoData\nFROM accounts_receivable ar\nWHERE ar.estado = 'EMITIDO' AND ar.vencimentoData < CURDATE()\nAND ar.tipo IN ('TITULO', 'RECEITA', 'ADIANTAMENTO')\nAND ar.valorRecebidoLiquido > 0\nORDER BY ar.valorRecebidoLiquido DESC\nLIMIT 10;\n",
